<Window x:Class="OneGamingOBFUSCATION.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OneGaming Obfuscation"
        Height="820" Width="1080"
        MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource HeaderBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4D73" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeInset" Background="{StaticResource PageBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="8" Height="8" Background="#3DDC97" Margin="0,0,8,0" />
                    <Border Width="8" Height="8" Background="#F0B429" Margin="0,0,8,0" />
                    <Border Width="8" Height="8" Background="#4C9AFF" Margin="0,0,12,0" />
                    <TextBlock Text="OneGaming Obfuscation" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#3DDC97" />
                <Rectangle Grid.Column="1" Fill="#F0B429" />
                <Rectangle Grid.Column="2" Fill="#4C9AFF" />
            </Grid>

            <Grid Grid.Row="2" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="168" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                    <TextBlock x:Name="FileKindText" DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" Text="No file yet" />
                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center"
                               Text="Drop a DLL, EXE, or plugin JAR. The page follows the file." />
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Files" Style="{StaticResource SectionLabel}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="Input" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="InputPathBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseInput_Click" />
                                </Grid>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="OutputPathBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2" Content="Save as" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                                </Grid>

                                <TextBlock Text="Password" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Key" Style="{StaticResource FieldLabel}" Width="72" />
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <PasswordBox x:Name="ProtectionKeyBox" MinHeight="32" MaxLength="256"
                                                     PasswordChanged="ProtectionKeyBox_PasswordChanged" />
                                        <TextBox x:Name="VisibleKeyBox" MinHeight="32" MaxLength="256"
                                                 Visibility="Collapsed" TextChanged="VisibleKeyBox_TextChanged" />
                                    </Grid>
                                    <Button Grid.Row="0" Grid.Column="2" Content="Generate" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" VerticalAlignment="Center" Click="GenerateKey_Click" />
                                    <CheckBox x:Name="ShowKeyBox" Grid.Row="0" Grid.Column="3" Content="Show"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              Checked="ShowKeyBox_Changed" Unchecked="ShowKeyBox_Changed" />

                                    <TextBlock Grid.Row="1" Text="Confirm" Style="{StaticResource FieldLabel}" Margin="0,8,8,0" Width="72" />
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <PasswordBox x:Name="ConfirmKeyBox" MinHeight="32" MaxLength="256"
                                                     PasswordChanged="ConfirmKeyBox_PasswordChanged" />
                                        <TextBox x:Name="VisibleConfirmKeyBox" MinHeight="32" MaxLength="256"
                                                 Visibility="Collapsed" TextChanged="VisibleConfirmKeyBox_TextChanged" />
                                    </Grid>
                                    <TextBlock x:Name="KeyStrengthText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                               Style="{StaticResource HintText}" Margin="0,8,0,0"
                                               Text="16 or more characters. The same key is used later to verify the file." />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{StaticResource LineBrush}" />

                        <Border Grid.Column="2" Background="{StaticResource SideBrush}" Padding="12,0,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="DllPageButton" Content="DLL" Style="{StaticResource PageButton}" Click="ShowDllPage_Click" />
                                    <Button x:Name="ExePageButton" Content="EXE" Style="{StaticResource PageButton}" Click="ShowExePage_Click" />
                                    <Button x:Name="JarPageButton" Content="JAR" Style="{StaticResource PageButton}" Click="ShowJarPage_Click" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <StackPanel x:Name="DotNetPage">
                                    <TextBlock x:Name="DotNetPageTitle" Text="DLL page" Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="DllNote" Style="{StaticResource HintText}" Margin="0,0,0,10"
                                               Text="Managed library. Unity, BepInEx, and Harmony names stay readable. WinZip opens a decoy archive after the file." />
                                    <TextBlock x:Name="ExeNote" Style="{StaticResource HintText}" Margin="0,0,0,10" Visibility="Collapsed"
                                               Text="Managed executable. The entry point stays in place. WinZip opens a decoy archive after the file." />
                                    <TextBlock Text="Preset" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged">
                                        <ComboBoxItem Content="Safe" IsSelected="True" Tag="safe" />
                                        <ComboBoxItem Content="Maximum" Tag="maximum" />
                                        <ComboBoxItem Content="Rename only" Tag="rename" />
                                        <ComboBoxItem Content="Custom" Tag="custom" />
                                    </ComboBox>

                                    <TextBlock Text="Names and files" Style="{StaticResource SectionLabel}" />
                                    <CheckBox x:Name="RenameMembersBox" Content="Rename methods and fields" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="RenameTypesBox" Content="Rename helper types" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="AggressiveRenamingBox" Content="Rename public members when safe" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="ProtectStringsBox" Content="Encrypt strings" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="ProtectResourcesBox" Content="Encrypt embedded resources" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="RuntimeObfuscationBox" Content="Add runtime decoys" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="LockOutputsBox" Content="Write an .oglock seal instead" IsChecked="False" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="OverwriteBox" Content="Overwrite an existing output" IsChecked="True" Click="LayerCheckBox_Click" />

                                    <TextBlock Text="IL and metadata" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                                    <CheckBox x:Name="ProtectIntegersBox" Content="Encode integer constants" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="ProxyCallsBox" Content="Proxy static calls" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="VirtualizeBox" Content="Virtualize eligible helpers" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="FlattenBox" Content="Control-flow maze" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="WeaveInstructionsBox" Content="Instruction weave" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="MultilayerBox" Content="Multilayer hardening" IsChecked="True" Click="LayerCheckBox_Click" />
                                    <CheckBox x:Name="MetadataPeBox" Content="Metadata and PE hardening" IsChecked="True" Click="LayerCheckBox_Click" />
                                        </StackPanel>
                                        <StackPanel x:Name="JarPage" Visibility="Collapsed">
                                            <TextBlock Text="JAR page" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="JarDetectedText" Style="{StaticResource HintText}" Margin="0,0,0,10"
                                                       Text="Drop a plugin JAR. Paper, Purpur, and Folia are detected from plugin.yml." />
                                            <TextBlock Text="Plugin protection" Style="{StaticResource SectionLabel}" />
                                            <CheckBox x:Name="JarRenameClassesBox" Content="Rename classes except the plugin main class" IsChecked="True" />
                                            <CheckBox x:Name="JarRenameMembersBox" Content="Rename private methods and fields" IsChecked="True" />
                                            <CheckBox x:Name="JarStringsBox" Content="Encrypt strings with a per-build cipher" IsChecked="True" />
                                            <CheckBox x:Name="JarNumbersBox" Content="Mix integer constants" IsChecked="True" />
                                            <CheckBox x:Name="JarStripDebugBox" Content="Strip debug and source names" IsChecked="True" />
                                            <CheckBox x:Name="JarShuffleBox" Content="Shuffle jar entries" IsChecked="True" />
                                            <CheckBox x:Name="JarArchiveBox" Content="Break WinZip extraction names" IsChecked="True" />
                                            <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                                                       Text="Lifecycle, commands, annotated listeners, and the plugin main class stay. WinZip extracts decoy names; the server reads the real jar." />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <ProgressBar x:Name="WorkProgress" Grid.Row="2" Margin="0,12,0,0" Minimum="0" Maximum="100"
                             Value="0" Visibility="Collapsed" IsIndeterminate="True" />

                <TextBox x:Name="LogBox" Grid.Row="3" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Background="{StaticResource LogBrush}" Foreground="{StaticResource LogTextBrush}"
                         BorderBrush="{StaticResource HeaderBrush}" BorderThickness="1,3,1,1" CaretBrush="{StaticResource LogTextBrush}" />

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Text="Drop a DLL, EXE, or plugin JAR."
                               Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource GhostButton}"
                                MinWidth="88" Click="UnlockButton_Click" />
                        <Button x:Name="VerifyButton" Content="Verify" Style="{StaticResource GhostButton}"
                                MinWidth="88" Margin="8,0,0,0" Click="VerifyButton_Click" />
                        <Button x:Name="ProtectButton" Content="Protect" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Click="ProtectButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
