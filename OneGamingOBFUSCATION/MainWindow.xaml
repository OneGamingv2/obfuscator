<Window x:Class="OneGamingOBFUSCATION.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneGamingOBFUSCATION"
        Height="920" Width="1080"
        MinHeight="740" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="IntroMotion">
            <DoubleAnimation Storyboard.TargetName="RootFade"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" />
            <ThicknessAnimation Storyboard.TargetName="RootFade"
                                Storyboard.TargetProperty="Margin"
                                From="0,18,0,0" To="0" Duration="0:0:0.45">
                <ThicknessAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
            <DoubleAnimation Storyboard.TargetName="AccentBar"
                             Storyboard.TargetProperty="Width"
                             From="0" To="72" Duration="0:0:0.55"
                             BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8EEF2" Offset="0" />
                <GradientStop Color="#D9E5EC" Offset="0.55" />
                <GradientStop Color="#D2E4DF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Rectangle Opacity="0.07" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,28 L28,0">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#15202B" Thickness="1" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border x:Name="RootFade" Opacity="0" Margin="0,18,0,0" Padding="36,28,36,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ONEGAMING" Style="{StaticResource BrandTitle}" FontSize="38" />
                        <TextBlock Text="OBFUSCATION" Style="{StaticResource BrandTitle}" FontSize="38" Margin="0,-6,0,0" />
                        <Rectangle x:Name="AccentBar" Height="4" Width="0" Fill="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Left" Margin="0,12,0,0" RadiusX="2" RadiusY="2" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" MaxWidth="520"
                                   Text="Fully local IL protection for Gorilla Tag / BepInEx mods. Drop a DLL or folder to begin." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Right" Text="CLI available" />
                        <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Right" Text="never leaves this PC" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource LineBrush}" Margin="0,0,0,20" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="SOURCE" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Input" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="InputPathBox" Grid.Column="1" MinHeight="36" VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="File" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BrowseInput_Click" />
                                <Button Grid.Column="3" Content="Folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseFolder_Click" />
                            </Grid>
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="OutputPathBox" Grid.Column="1" MinHeight="36" VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="Choose" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BrowseOutput_Click" />
                            </Grid>

                            <TextBlock Text="MASTER KEY" Style="{StaticResource SectionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <PasswordBox x:Name="ProtectionKeyBox" MinHeight="36" MaxLength="256"
                                                     PasswordChanged="ProtectionKeyBox_PasswordChanged" />
                                        <TextBox x:Name="VisibleKeyBox" MinHeight="36" MaxLength="256"
                                                 Visibility="Collapsed" TextChanged="VisibleKeyBox_TextChanged" />
                                    </Grid>
                                    <PasswordBox x:Name="ConfirmKeyBox" MinHeight="36" Margin="0,8,0,0" MaxLength="256"
                                                 PasswordChanged="ConfirmKeyBox_PasswordChanged" />
                                    <TextBox x:Name="VisibleConfirmKeyBox" MinHeight="36" Margin="0,8,0,0" MaxLength="256"
                                             Visibility="Collapsed" TextChanged="VisibleConfirmKeyBox_TextChanged" />
                                    <TextBlock x:Name="KeyStrengthText" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                               Text="16+ character password required for integrity. Protected DLL stays game-loadable." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Generate" Margin="10,0,0,0" VerticalAlignment="Top"
                                        Click="GenerateKey_Click" />
                                <CheckBox x:Name="ShowKeyBox" Grid.Column="2" Content="Show" VerticalAlignment="Top"
                                          Margin="12,8,0,0" Checked="ShowKeyBox_Changed" Unchecked="ShowKeyBox_Changed" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{StaticResource LineBrush}" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="PRESET" Style="{StaticResource SectionLabel}" />
                            <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged">
                                <ComboBoxItem Content="Safe (recommended)" IsSelected="True" Tag="safe" />
                                <ComboBoxItem Content="Maximum" Tag="maximum" />
                                <ComboBoxItem Content="Rename only" Tag="rename" />
                                <ComboBoxItem Content="Custom" Tag="custom" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,16"
                                       Text="Presets fill the layers. Pick Custom to mix." />

                            <TextBlock Text="IDENTIFIERS" Style="{StaticResource SectionLabel}" />
                            <CheckBox x:Name="RenameMembersBox" Content="Rename private methods / fields" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="RenameTypesBox" Content="Rename helper types" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="AggressiveRenamingBox" Content="Maximum compatible coverage" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="ProtectStringsBox" Content="Encrypt strings" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="ProtectResourcesBox" Content="Encrypt embedded resources" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="RuntimeObfuscationBox" Content="Runtime decoys / bootstrap" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="ProtectFolderBox" Content="Protect whole folder" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="LockOutputsBox" Content="Offline .oglock seal (optional)" IsChecked="False" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="OverwriteBox" Content="Overwrite Protected output" IsChecked="True" Click="LayerCheckBox_Click" />

                            <TextBlock Text="IL / METADATA" Style="{StaticResource SectionLabel}" Margin="0,16,0,8" />
                            <CheckBox x:Name="ProtectIntegersBox" Content="Encode integer constants" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="ProxyCallsBox" Content="Proxy static calls" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="VirtualizeBox" Content="Real VM virtualization (Int32/bool/void + branches)" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="FlattenBox" Content="Control-flow maze" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="WeaveInstructionsBox" Content="Every-line IL weave + dense noise" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="MultilayerBox" Content="Multilayer hardening + custom methods" IsChecked="True" Click="LayerCheckBox_Click" />
                            <CheckBox x:Name="MetadataPeBox" Content="Harden metadata / PE" IsChecked="True" Click="LayerCheckBox_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ProgressBar x:Name="WorkProgress" Grid.Row="3" Margin="0,16,0,8" Minimum="0" Maximum="100"
                             Value="0" Visibility="Collapsed" IsIndeterminate="True" />

                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ACTIVITY" Style="{StaticResource SectionLabel}" />
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Background="{StaticResource LogBrush}" Foreground="{StaticResource LogTextBrush}"
                             BorderBrush="#2A3642" CaretBrush="{StaticResource LogTextBrush}" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Text="Drop a managed assembly or a whole mod folder anywhere on this window."
                               Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource GhostButton}"
                                MinWidth="100" Click="UnlockButton_Click" />
                        <Button x:Name="VerifyButton" Content="Verify" Style="{StaticResource GhostButton}"
                                MinWidth="100" Margin="8,0,0,0" Click="VerifyButton_Click" />
                        <Button x:Name="ProtectButton" Content="Protect locally" Style="{StaticResource PrimaryButton}"
                                MinWidth="160" Margin="8,0,0,0" Click="ProtectButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
